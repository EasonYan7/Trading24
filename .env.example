# 复制为 .env 并填入真实值。.env 不进 git。
# 批量分析默认用 DeepSeek（便宜）。
DEEPSEEK_API_KEY=

# 必需：News 分析师会调宏观工具走 FRED，缺这个 key 整次运行会崩。
# 免费申请：https://fredaccount.stlouisfed.org/apikey
FRED_API_KEY=

# 可选：若把某些数据源 vendor 切到 Alpha Vantage 才需要
# ALPHA_VANTAGE_API_KEY=

# 可选：其它 LLM 提供商
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=

# ────────────────────────── 部署（上云）相关 ──────────────────────────
# 容器时区：影响每日批量分析的触发时间（deploy/crontab 里的点）。
TZ=Asia/Hong_Kong

# Cloudflare Tunnel 令牌：Zero Trust → Networks → Tunnels 创建隧道后复制。
# 对外访问看板全靠它，不用开公网端口。
TUNNEL_TOKEN=

# 可选：SQLite → Cloudflare R2 持续备份（用 `docker compose --profile backup up -d litestream` 开启）
# LITESTREAM_R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# LITESTREAM_R2_BUCKET=trading24-backup
# LITESTREAM_R2_ACCESS_KEY_ID=
# LITESTREAM_R2_SECRET_ACCESS_KEY=
